{
    "headers": [
      {
        "source": "/(.*)",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'nonce-random123'; style-src 'self'; img-src 'self' data:; object-src 'none'; font-src 'self'; connect-src 'self'; frame-ancestors 'none';"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      }
    ],
    "builds": [
      {
        "src": "src/main.jsx",
        "use": "@vercel/static"
      }
    ],
    "redirects": [
      {
        "source": "/(.*)",
        "destination": "https://cv-axelberger.vercel.app/$1",
        "permanent": true
      }
    ]
}
  
